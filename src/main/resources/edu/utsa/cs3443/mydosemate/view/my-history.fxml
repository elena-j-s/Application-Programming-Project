<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="840.0" prefWidth="550.0" style="-fx-background-color: #a7c8ee;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.mydosemate.controller.MyHistoryController">

   <children>

      <!-- Header background -->
      <Rectangle arcHeight="5.0" arcWidth="5.0" fill="WHITE" height="140.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="550.0">

         <effect>
            <DropShadow blurType="ONE_PASS_BOX" offsetY="2.0">

               <color>
                  <Color red="0.31578946113586426" green="0.30994153022766113" blue="0.30994153022766113" />
               </color>
            </DropShadow>
         </effect>
      </Rectangle>

      <BorderPane prefHeight="840.0" prefWidth="550.0">

         <!-- Header -->
         <top>
            <HBox prefHeight="140.0" prefWidth="550.0" BorderPane.alignment="CENTER">

               <children>

                  <VBox prefWidth="451.0">

                     <children>
                        <Label fx:id="dateLabel" prefHeight="36.0" prefWidth="372.0">

                           <font>
                              <Font name="Arial Rounded MT Bold" size="20.0" />
                           </font>

                           <VBox.margin>
                              <Insets left="10.0" top="60.0" />
                           </VBox.margin>
                        </Label>

                        <Label fx:id="greetingLabel" prefHeight="50.0" prefWidth="451.0">

                           <font>
                              <Font name="Arial Rounded MT Bold" size="35.0" />
                           </font>

                           <VBox.margin>
                              <Insets left="10.0" />
                           </VBox.margin>
                        </Label>
                     </children>
                  </VBox>

                  <Button mnemonicParsing="false" onAction="#goToSettings" prefHeight="49.0" prefWidth="51.0" style="-fx-background-radius: 100;                                        -fx-background-color: white;" text="Settings">

                     <font>
                        <Font name="Arial Rounded MT Bold" size="9.0" />
                     </font>

                     <effect>
                        <DropShadow blurType="ONE_PASS_BOX" offsetY="2.0">

                           <color>
                              <Color red="0.6315789222717285" green="0.6228070259094238" blue="0.6228070259094238" />
                           </color>
                        </DropShadow>
                     </effect>

                     <HBox.margin>
                        <Insets left="28.0" top="82.0" />
                     </HBox.margin>
                  </Button>

               </children>
            </HBox>
         </top>

         <!-- Navigation bar -->
         <bottom>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="550.0" spacing="20.0" BorderPane.alignment="CENTER">

               <padding>
                  <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
               </padding>

               <children>

                  <Button mnemonicParsing="false" onAction="#goToDash" prefHeight="79.0" prefWidth="150.0" styleClass="primary-button" stylesheets="@style.css" text="Home">

                     <font>
                        <Font name="Arial Rounded MT Bold" size="30.0" />
                     </font>
                  </Button>

                  <Button mnemonicParsing="false" onAction="#goToMedicine" prefHeight="79.0" prefWidth="150.0" style="-fx-font-size: 26;" styleClass="primary-button" stylesheets="@style.css" text="Medicine">

                     <font>
                        <Font name="Arial Rounded MT Bold" size="26.0" />
                     </font>
                  </Button>

                  <Button mnemonicParsing="false" onAction="#goToHistory" prefHeight="79.0" prefWidth="150.0" style="-fx-font-size: 30;" styleClass="primary-button" stylesheets="@style.css" text="History">

                     <font>
                        <Font name="Arial Rounded MT Bold" size="25.0" />
                     </font>
                  </Button>

               </children>
            </HBox>
         </bottom>

         <!-- History area -->
         <center>
            <StackPane prefHeight="600.0" prefWidth="550.0" BorderPane.alignment="CENTER">

               <children>

                  <!-- White history card -->
                  <Rectangle arcHeight="30.0" arcWidth="30.0" fill="WHITE" height="572.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="0.0" width="530.0">

                     <effect>
                        <DropShadow blurType="ONE_PASS_BOX" offsetY="2.0">

                           <color>
                              <Color red="0.31578946113586426" green="0.30994153022766113" blue="0.30994153022766113" />
                           </color>
                        </DropShadow>
                     </effect>
                  </Rectangle>

                  <!-- Scrollable history entries -->
                  <ScrollPane fx:id="historyScrollPane" fitToWidth="true" hbarPolicy="NEVER" pannable="true" prefHeight="500.0" prefWidth="500.0" style="-fx-background-color: transparent;                                            -fx-background: transparent;                                            -fx-background-radius: 15;">

                     <content>
                        <VBox fx:id="historyContainer" fillWidth="true" prefWidth="480.0" spacing="10.0" style="-fx-background-color: white;">

                           <padding>
                              <Insets bottom="80.0" left="15.0" right="15.0" top="10.0" />
                           </padding>
                        </VBox>
                     </content>

                     <StackPane.margin>
                        <Insets bottom="20.0" left="15.0" right="15.0" top="40.0" />
                     </StackPane.margin>
                  </ScrollPane>

                  <!-- Add medication button -->
                  <Button mnemonicParsing="false" onAction="#addMedication" prefHeight="59.0" prefWidth="63.0" maxHeight="59.0" maxWidth="63.0" minHeight="59.0" minWidth="63.0" style="-fx-font-size: 32px; -fx-padding: 0" styleClass="primary-button" stylesheets="@style.css" text="+" textOverrun="CLIP" StackPane.alignment="BOTTOM_RIGHT">

                     <StackPane.margin>
                        <Insets bottom="25.0" right="22.0" />
                     </StackPane.margin>
                  </Button>

                  <!-- Section title -->
                  <Label maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="23.0" prefWidth="184.0" text="MY HISTORY" textFill="#6b6b6b">

                     <font>
                        <Font name="Arial Rounded MT Bold" size="20.0" />
                     </font>

                     <StackPane.margin>
                        <Insets bottom="515.0" right="315.0" />
                     </StackPane.margin>
                  </Label>

               </children>
            </StackPane>
         </center>

      </BorderPane>

   </children>
</AnchorPane>
